{
  "name": "elion-suite",
  "private": true,
  "version": "0.7.0",
  "description": "Elion Suite \u2014 local-first personal productivity suite (web + Windows desktop)",
  "author": "Gilang N Adha",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:design && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test:e2e": "playwright test",
    "check:design": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@blocksuite/affine-model": "0.19.5",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/global": "0.19.5",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/fiber": "^8.17.10",
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.0.11",
    "howler": "^2.2.4",
    "lucide-react": "^0.451.0",
    "motion": "^13.2.0",
    "onnxruntime-web": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "three": "^0.169.0",
    "yjs": "^13.6.27",
    "zustand": "^4.5.5",
    "@blocksuite/block-std": "0.19.5",
    "@preact/signals-core": "1.14.4",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.7.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.elion.suite",
    "productName": "Elion Suite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "THIRD_PARTY_LICENSES.md",
      "third-party/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    }
  },
  "overrides": {
    "@blocksuite/icons": "2.1.75",
    "file-type": "21.3.2"
  }
}
